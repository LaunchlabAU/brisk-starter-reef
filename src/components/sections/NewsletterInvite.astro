---
import type { Section } from '../../../definition';
import { linkValue } from '../../data';
// An invitation to follow the blog or get in touch: by email, the feed, a
// phone number or another website. A static site sends no forms.
const { section, from } = Astro.props as {
  section: Extract<Section, { type: 'newsletter-invite' }>;
  from: string;
};
---

<section class="container-page py-16">
  <div class="flex flex-col gap-6 rounded-3xl bg-foreground p-10 text-background md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 class="font-display text-3xl font-semibold tracking-tight">
        {section.heading}
      </h2>
      <p class="mt-3 opacity-80">{section.body}</p>
    </div>
    <a
      class="w-fit rounded-full bg-primary px-6 py-3 font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      href={linkValue(from)(section.action)}
    >
      {section.actionLabel}
    </a>
  </div>
</section>
