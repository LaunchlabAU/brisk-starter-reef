---
import type { Post } from '../../schema';
import {
  linkFrom,
  longDate,
  releaseUrl,
  rootFrom,
  sizeOf,
  toneClasses,
  topicOf,
} from '../data';
// A post as a card: its cover, topic, headline, summary and date.
const { post, from, large } = Astro.props as {
  post: Post;
  from: string;
  large?: boolean;
};
const topic = topicOf(post.topic);
const href = linkFrom(from)({ post: post.slug });
---

<article
  class:list={[
    'group overflow-hidden rounded-3xl border border-border bg-card transition-colors hover:border-foreground/30',
    large && 'md:grid md:grid-cols-2',
  ]}
>
  <a href={href} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <img
      class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      src={releaseUrl(post.cover.asset, rootFrom(from))}
      alt={post.cover.alt}
      loading="lazy"
      {...sizeOf(post.cover.asset)}
    />
  </a>
  <div class="flex flex-col gap-3 p-6">
    <span
      class:list={[
        'w-fit rounded-full px-3 py-1 text-xs font-medium',
        toneClasses[topic.tone].chip,
      ]}
    >
      {topic.name}
    </span>
    <h3
      class:list={[
        'font-display font-semibold tracking-tight',
        large ? 'text-3xl' : 'text-xl',
      ]}
    >
      <a href={href} class="hover:underline">
        {post.headline}
      </a>
    </h3>
    <p class="text-muted-foreground">{post.summary}</p>
    {post.publishedAt && (
      <time class="text-sm text-muted-foreground" datetime={post.publishedAt}>
        {longDate(post.publishedAt)}
      </time>
    )}
  </div>
</article>
